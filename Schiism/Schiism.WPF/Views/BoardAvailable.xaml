<UserControl x:Class="Schiism.WPF.Views.BoardAvailable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"   
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:viewmodels="clr-namespace:Schiism.WPF.ViewModels"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Width="300" Height="360"
             Background="DarkGray">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text= "BoardAvailable Message" Margin="0,10" FontSize="16" FontWeight="Bold" TextAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1">
            <TextBlock Text="BoardID:" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
            <TextBox x:Name="BoardIDText" Text="{Binding BoardID, UpdateSourceTrigger=PropertyChanged}" Margin="125,5,0,5" Width="150" Height="25" MaxLength="36" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
        </Grid>
        <Grid Grid.Row="2">
            <TextBlock Text="Width:" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
            <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Margin="125,5,0,5" Width="150" Height="25" MaxLength="4" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
        </Grid>
        <Grid Grid.Row="3">
            <TextBlock Text="FailedBoard:" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
            <ComboBox Name="FailedBoardBox" DisplayMemberPath="Display" SelectedValuePath="Value" ItemsSource="{Binding FailedOptions}" SelectedValue="{Binding FailedBoard, Mode=TwoWay}" Margin="125,5,0,5" VerticalAlignment="Center" HorizontalAlignment="Left" Width="150" Height="25" FontSize="14"/>
        </Grid>
        <Grid Grid.Row="4">
            <TextBlock Text="FlippedBoard:" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
            <ComboBox Name="FlippedBoardBox" DisplayMemberPath="Display" SelectedValuePath="Value" ItemsSource="{Binding FlippedOptions}" SelectedValue="{Binding FlippedBoard, Mode=TwoWay}" Margin="125,5,0,5" VerticalAlignment="Center" HorizontalAlignment="Left" Width="150" Height="25" FontSize="14"/>
        </Grid>
        <Grid Grid.Row="5">
            <TextBlock Text="Receive From:" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
            <ToggleButton IsChecked="{Binding ReceiptDir, UpdateSourceTrigger=PropertyChanged}" Margin="125,5,0,5"  Width="150" Height="25" VerticalAlignment="Center" HorizontalAlignment="Left">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Content" Value="UPSTREAM"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ReceiptDir}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Content" Value="DOWNSTREAM"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </Grid>
        <Grid Grid.Row="6">
            <TextBlock Text="TopBarcode:" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
            <TextBox Text="{Binding TopBarcode, UpdateSourceTrigger=PropertyChanged}" Margin="125,5,0,5" Width="150" Height="25" MaxLength="20" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
        </Grid>
        <Grid Grid.Row="7">
            <TextBlock Text="BottomBarcode:" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
            <TextBox Text="{Binding BottomBarcode, UpdateSourceTrigger=PropertyChanged}" Margin="125,5,0,5" Width="150" Height="25" MaxLength="20" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
        </Grid>
        <Grid Grid.Row="8">
            <TextBlock Text="PartName:" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
            <TextBox Text="{Binding PartName, UpdateSourceTrigger=PropertyChanged}" Margin="125,5,0,5" Width="150" Height="25" MaxLength="22" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
        </Grid>
        <Grid Grid.Row="9">
            <Button Content="SEND" Command="{Binding SendClick}" Margin="0,5" Width="100" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=BoardIDText, Path=Text.Length}" Value="0">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
