<UserControl x:Class="Schiism.Views.ConnSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"   
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:viewmodels="clr-namespace:Schiism.ViewModels"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Width="500" Height="170"
             Background="DarkGray">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border BorderBrush="Black" BorderThickness="1" Padding="5" CornerRadius="1" Margin="10,5,5,5" Grid.RowSpan="2" >
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0">
                            <TextBlock Text= "TCP Config" FontSize="16" FontWeight="Bold" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="IP Address:" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                            <TextBox Text="{Binding MS.IPAddr, UpdateSourceTrigger=PropertyChanged}" Margin="75,5,5,0" Width="150" Height="25" MaxLength="15" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="Port:" Margin="37,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                            <TextBox Text="{Binding MS.TCPPort, UpdateSourceTrigger=PropertyChanged}" Margin="75,5,5,0" Width="150" Height="25" MaxLength="5" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Border BorderBrush="Black" BorderThickness="1" Padding="5" CornerRadius="1" Margin="10,5,5,5" Grid.RowSpan="2" Grid.ColumnSpan="2">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <TextBlock Text= "Timing" FontSize="16" FontWeight="Bold" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Scan Rate (ms):" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Grid.ColumnSpan="2"/>
                            <TextBox Text="{Binding MS.ScanRate, UpdateSourceTrigger=PropertyChanged}" Margin="100,5,0,0" Width="125" Height="25" MaxLength="5" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="14"/>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="Timeout (ms):" Margin="17,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                            <TextBox Text="{Binding MS.TCPTimeout, UpdateSourceTrigger=PropertyChanged}" Margin="110,5,5,0" Width="120" Height="25" MaxLength="5" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    
</UserControl>
