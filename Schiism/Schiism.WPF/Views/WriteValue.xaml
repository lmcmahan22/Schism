<UserControl x:Class="Schiism.WPF.Views.WriteValue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"   
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:viewmodels="clr-namespace:Schiism.WPF.ViewModels"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Width="300" Height="210"
             Background="DarkGray">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text= "Write Single Value" Margin="0,10" FontSize="16" FontWeight="Bold" TextAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1">
            <TextBlock Text="Type:" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
            <ToggleButton IsChecked="{Binding SendReg, UpdateSourceTrigger=PropertyChanged}" Margin="150,5,0,5"  Width="100" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Content" Value="COIL"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SendReg}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Content" Value="REGISTER"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </Grid>
        <Grid Grid.Row="2">
            <TextBlock Text="Address (Decimal):" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
            <TextBox x:Name="AddressText" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,25,5" Width="100" Height="25" MaxLength="32" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="14"/>
        </Grid>
        <Grid Grid.Row="3">
            <TextBlock Text="Value (Num Base):" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
            <TextBox x:Name="ValueText" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,25,5" Width="100" Height="25" MaxLength="32" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="14"/>
        </Grid>
        <Grid Grid.Row="4">
            <Button Content="SEND" Command="{Binding WriteClick}" Margin="0,5" Width="100" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=AddressText, Path=Text.Length}" Value="0">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=ValueText, Path=Text.Length}" Value="0">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
