<UserControl Width="500" Height="300"
             x:Class="Schism.Views.About"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"   
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:viewmodels="clr-namespace:Schism.ViewModels"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="DarkGray">
    <UserControl.Resources>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.Column="0">
            <Image Source="/Images/PVALogo.png" Width="150" Height="100" Margin="10" HorizontalAlignment="Left"/>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="250" Height="100">
                <TextBlock Text="{Binding AppName}" FontSize="30" FontWeight="Bold" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Width="400" Margin="10,0,0,0">
                <TextBlock Text="{Binding Version}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding BuildDate}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />
                <TextBlock Text="{Binding Author}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />
                <TextBlock Text="{Binding Copyright}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
