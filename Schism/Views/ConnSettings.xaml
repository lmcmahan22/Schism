<UserControl x:Class="Schism.Views.ConnSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Schism.Views"
             mc:Ignorable="d" 
             Width="500" Height="270"
             Background="DarkGray">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border BorderBrush="Black" BorderThickness="1" Padding="5" CornerRadius="1" Margin="10,5,5,5" Grid.RowSpan="2" >
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0">
                            <TextBlock Text= "TCP Config" FontSize="16" FontWeight="Bold" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="IP Address:" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                            <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Margin="75,5,5,0" Width="150" Height="25" MaxLength="15" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="Port:" Margin="37,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                            <TextBox Text="{Binding TCPPort, UpdateSourceTrigger=PropertyChanged}" Margin="75,5,5,0" Width="150" Height="25" MaxLength="3" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Border BorderBrush="Black" BorderThickness="1" Padding="5" CornerRadius="1" Margin="10,5,5,5" Grid.RowSpan="2" Grid.ColumnSpan="2">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <TextBlock Text= "Timing" FontSize="16" FontWeight="Bold" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Scan Rate (ms):" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Grid.ColumnSpan="2"/>
                            <TextBox Text="{Binding ScanRate, UpdateSourceTrigger=PropertyChanged}" Margin="100,5,0,0" Width="125" Height="25" MaxLength="5" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="14"/>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="Timeout (ms):" Margin="17,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                            <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" Margin="110,5,5,0" Width="120" Height="25" MaxLength="5" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                        </Grid>
                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="Delay Between Polls (ms):" Margin="170,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                            <TextBox Text="{Binding PollDelay, UpdateSourceTrigger=PropertyChanged}" Margin="335,5,0,0" Width="120" Height="25" MaxLength="4" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="14" Grid.ColumnSpan="2"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <Border BorderBrush="Black" BorderThickness="1" Padding="5" CornerRadius="1" Margin="10,5,5,5" Grid.RowSpan="2" Grid.ColumnSpan="2">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text= "Addressing" FontSize="16" FontWeight="Bold" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock Text="Address Convention:" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                            <ComboBox Name="AddressConv" ItemsSource="{Binding AddressConvention, UpdateSourceTrigger=PropertyChanged}" SelectedValue="{Binding SelectedAddressConvention, Mode=TwoWay}" Margin="135,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="320" Height="25" FontSize="14"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
