<UserControl x:Class="Schism.Views.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"   
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:viewmodels="clr-namespace:Schism.ViewModels"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!-- Existing resources -->
        <CollectionViewSource x:Key="ShiftColumnView" Source="{Binding ShiftColumn}" />
        <CollectionViewSource x:Key="MODBUS_S1" Source="{Binding MODBUSDataPoints[0]}" />
        <CollectionViewSource x:Key="MODBUS_S2" Source="{Binding MODBUSDataPoints[1]}" />
        <CollectionViewSource x:Key="MODBUS_S3" Source="{Binding MODBUSDataPoints[2]}" />
        <CollectionViewSource x:Key="MODBUS_S4" Source="{Binding MODBUSDataPoints[3]}" />
        <CollectionViewSource x:Key="MODBUS_S5" Source="{Binding MODBUSDataPoints[4]}" />
        <CollectionViewSource x:Key="MODBUS_S6" Source="{Binding MODBUSDataPoints[5]}" />

        <!-- Reusable template for a MODBUS column to remove duplication -->
        <DataTemplate x:Key="ModbusColumnTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header row: Alias + dynamic column header bound to Address1 on the view model -->
                <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="#FFFF" Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="4,0" BorderBrush="Black" BorderThickness="0,0,1,0">
                            <TextBlock Text="Alias" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0" FontWeight="Bold"/>
                        </Border>
                        <Border Grid.Column="1" Padding="4,0" BorderBrush="Black" BorderThickness="0,0,1,0">
                            <!-- Bind to the parent UserControl DataContext.Address1 like the original -->
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0" FontWeight="Bold"
                                       Text="{Binding DataContext.Address1, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ItemsControl with alias + data columns.
                     The DataTemplate's DataContext is the collection passed as Content. -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <ItemsControl ItemsSource="{Binding}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="21">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="98" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="4,0" BorderBrush="Black" BorderThickness="0,0,1,1">
                                        <TextBox Text="{Binding Alias, Mode=TwoWay}" VerticalAlignment="Center" BorderBrush="Transparent"/>
                                    </Border>
                                    <Border Grid.Column="1" Padding="4,0" BorderBrush="Black" BorderThickness="0,0,1,1">
                                        <TextBlock Text="{Binding Data}" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="100" />
            <RowDefinition Height="462" />
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem Header="_Save" Command="{Binding Save_Click}"/>
                    <MenuItem Header="_Load" Command="{Binding Load_Click}"/>
                    <Separator />
                    <MenuItem Header="_Exit" Command="{Binding Exit_Click}"/>
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Header="_Cut" Command="{Binding Cut_Click}"/>
                    <MenuItem Header="_Copy" Command="{Binding Copy_Click}"/>
                    <MenuItem Header="_Paste" Command="{Binding Paste_Click}"/>
                </MenuItem>
                <MenuItem Header="_Connection">
                    <MenuItem Header="_Connect" Command="{Binding Conn_Click}"/>
                    <MenuItem Header="_Disconnect" Command="{Binding Disc_Click}"/>
                    <Separator />
                    <MenuItem Header="_Settings" Command="{Binding Sett_Click}"/>
                </MenuItem>
                <MenuItem Header="_Simulation">
                    <MenuItem Header="_Scan Rate" Command="{Binding ScanRt_Click}"/>
                    <MenuItem Header="_Insert Error" Command="{Binding InsErr_Click}"/>
                </MenuItem>
                <MenuItem Header="_Customize">
                    <MenuItem Header="_Themes" Command="{Binding Themes_Click}"/>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="_About" Command="{Binding About_Click}"/>
                </MenuItem>
            </Menu>
        </Grid>
        <Grid Grid.Row="1">
            <Button Name="Save" ToolTip="Save Config" HorizontalAlignment="Left" Width="35" Height="25" Margin="5,0,0,0" Command="{Binding Save_Click}">
                <Image Source="/Images/Save.png" />
            </Button>
            <Button Name="Load" ToolTip="Load Config" HorizontalAlignment="Left" Width="35" Height="25" Margin="45,0,0,0" Command="{Binding Load_Click}">
                <Image Source="/Images/Load.png" />
            </Button>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="85,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="2" Height="25" Background="Black"/>
            <Button Name="Cut" ToolTip="Cut" HorizontalAlignment="Left" Width="35" Height="25" Margin="95,0,0,0" Command="{Binding Cut_Click}">
                <Image Source="/Images/Cut.png" />
            </Button>
            <Button Name="Copy" ToolTip="Copy" HorizontalAlignment="Left" Width="35" Height="25" Margin="135,0,0,0" Command="{Binding Copy_Click}">
                <Image Source="/Images/Copy.png" />
            </Button>
            <Button Name="Paste" ToolTip="Paste" HorizontalAlignment="Left" Width="35" Height="25" Margin="175,0,0,0" Command="{Binding Paste_Click}">
                <Image Source="/Images/Paste.png" />
            </Button>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="215,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="2" Height="25" Background="Black"/>
            <Button Name="Connect" ToolTip="Connect" HorizontalAlignment="Left" Width="35" Height="25" Margin="225,0,0,0" Command="{Binding Conn_Click}">
                <Image Source="/Images/Connect.png" />
            </Button>
            <Button Name="Settings" ToolTip="Settings" HorizontalAlignment="Left" Width="35" Height="25" Margin="265,0,0,0" Command="{Binding Sett_Click}">
                <Image Source="/Images/Settings.png" />
            </Button>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Border BorderBrush="Black" BorderThickness="1" Padding="5,0" CornerRadius="1" Margin="10,5,5,5">
                    <StackPanel>
                        <TextBlock Text="Device Settings" FontSize="16" FontWeight="Bold" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Device ID" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                                <TextBox Text="{Binding DeviceID}" Margin="70,0,5,0" Width="60" Height="25" MaxLength="1" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="Length" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                                <TextBox Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" Margin="80,0,5,0" Width="65" Height="25" MaxLength="3" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Address" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                                <TextBox Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" Margin="70,0,5,0" Width="60" Height="25" MaxLength="8" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Data Type" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                                <ComboBox Name="DataType" Margin="80,0,5,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="200" Height="25" FontSize="14">
                                    <ComboBoxItem Content="Coil Status"></ComboBoxItem>
                                    <ComboBoxItem Content="Input Status"></ComboBoxItem>
                                    <ComboBoxItem Content="Holding Registers"></ComboBoxItem>
                                    <ComboBoxItem Content="Input Registers"></ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Column="1">
                <Border BorderBrush="Black" BorderThickness="1" Padding="5,0" CornerRadius="1" Margin="10,5,5,5">
                    <StackPanel>
                        <TextBlock Text="Display Options" FontSize="16" FontWeight="Bold" />
                        <Grid Margin="5,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Numeric Base" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                                <ComboBox Name="BaseSystem" Margin="100,0,5,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="240" Height="25" FontSize="14">
                                    <ComboBoxItem Content="Decimal"></ComboBoxItem>
                                    <ComboBoxItem Content="Integer"></ComboBoxItem>
                                    <ComboBoxItem Content="Hexadecimal"></ComboBoxItem>
                                    <ComboBoxItem Content="Binary"></ComboBoxItem>
                                    <ComboBoxItem Content="32 Bit Float"></ComboBoxItem>
                                    <ComboBoxItem Content="32 Bit SW. Float"></ComboBoxItem>
                                    <ComboBoxItem Content="64 Bit Float"></ComboBoxItem>
                                    <ComboBoxItem Content="64 Bit SW. Float"></ComboBoxItem>
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Endian" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                                <ComboBox Name="Endian" Margin="100,0,5,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="240" Height="25" FontSize="14">
                                    <ComboBoxItem Content="Big Endian"></ComboBoxItem>
                                    <ComboBoxItem Content="Little Endian"></ComboBoxItem>
                                    <ComboBoxItem Content="Big Endian (Swap Words)"></ComboBoxItem>
                                    <ComboBoxItem Content="Big Endian (Swap Bytes)"></ComboBoxItem>
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="ASCII Display" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                                <CheckBox IsEnabled="{Binding ASCIIEnable}" Content="Enable" Margin="100,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Display Type" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                                <ComboBox Name="ASCIIType" Margin="100,0,5,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="160" Height="25" FontSize="14">
                                    <ComboBoxItem Content="1 Char/Reg"></ComboBoxItem>
                                    <ComboBoxItem Content="2 Char/Reg"></ComboBoxItem>
                                    <ComboBoxItem Content="2 Char/Reg SW."></ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="3">
            <Border BorderBrush="Black" BorderThickness="1" Margin="10,5,40,5" CornerRadius="1">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <!-- Shift column header + items -->
                        <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="21">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="#FFF" Grid.Row="0">
                                <TextBlock Text="Shift" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" />
                            </Border>

                            <!-- ItemsControl wrapped in ScrollViewer to mimic DataGrid scrolling -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" HorizontalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding Source={StaticResource ShiftColumnView}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="21"/>
                                                </Grid.RowDefinitions>
                                                <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="#FFF" Grid.Row="0">
                                                    <TextBlock Text="{Binding Value}" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Replace repeated MODBUS column blocks with ContentControls using the template -->
                        <ContentControl Grid.Row="0" Grid.Column="1" Grid.RowSpan="21" Margin="0,0,2,0"
                                        Visibility="{Binding ColsVis[0]}"
                                        Content="{Binding MODBUSDataPoints[0]}"
                                        ContentTemplate="{StaticResource ModbusColumnTemplate}" />

                        <ContentControl Grid.Row="0" Grid.Column="2" Grid.RowSpan="21" Margin="0,0,2,0"
                                        Visibility="{Binding ColsVis[1]}"
                                        Content="{Binding MODBUSDataPoints[1]}"
                                        ContentTemplate="{StaticResource ModbusColumnTemplate}" />

                        <ContentControl Grid.Row="0" Grid.Column="3" Grid.RowSpan="21" Margin="0,0,2,0"
                                        Visibility="{Binding ColsVis[2]}"
                                        Content="{Binding MODBUSDataPoints[2]}"
                                        ContentTemplate="{StaticResource ModbusColumnTemplate}" />

                        <ContentControl Grid.Row="0" Grid.Column="4" Grid.RowSpan="21" Margin="0,0,2,0"
                                        Visibility="{Binding ColsVis[3]}"
                                        Content="{Binding MODBUSDataPoints[3]}"
                                        ContentTemplate="{StaticResource ModbusColumnTemplate}" />

                        <ContentControl Grid.Row="0" Grid.Column="5" Grid.RowSpan="21" Margin="0,0,2,0"
                                        Visibility="{Binding ColsVis[4]}"
                                        Content="{Binding MODBUSDataPoints[4]}"
                                        ContentTemplate="{StaticResource ModbusColumnTemplate}" />

                        <ContentControl Grid.Row="0" Grid.Column="6" Grid.RowSpan="21" Margin="0,0,2,0"
                                        Visibility="{Binding ColsVis[5]}"
                                        Content="{Binding MODBUSDataPoints[5]}"
                                        ContentTemplate="{StaticResource ModbusColumnTemplate}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="4">
            <Border BorderBrush="Black" BorderThickness="1" Margin="10,5,40,5" CornerRadius="1">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <!--<TextBlock Text="{Binding NumPolls, StringFormat=Polls: {}}" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>-->
                            <TextBlock Text="Polls: 0" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1">
                            <!--<TextBlock Text="{Binding NumOK, StringFormat=OK: {}}" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>-->
                            <TextBlock Text="OK: 0" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="2">
                            <!--<TextBlock Text="{Binding NumErrors, StringFormat=Error: {}}" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>-->
                            <TextBlock Text="Errors: 0" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="4">
                            <!--<TextBlock Text="{Binding NumTX, StringFormat=Tx: {} B}" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>-->
                            <TextBlock Text="Tx: 0 B" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="4">
                            <!--<TextBlock Text="{Binding NumTXKBs, StringFormat={} KB/s}" Margin="50,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>-->
                            <TextBlock Text="0.00 KB/s" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="5">
                            <!--<TextBlock Text="{Binding NumRX, StringFormat=Tx: {} B}" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>-->
                            <TextBlock Text="Rx: 0 B" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="5">
                            <!--<TextBlock Text="{Binding NumRXKBs, StringFormat={} KB/s}" Margin="50,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>-->
                            <TextBlock Text="0.00 KB/s" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="6">
                            <!--<TextBlock Text="{Binding NumRequests, StringFormat=Requests: {}}" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>-->
                            <TextBlock Text="Requests: 0" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="6">
                            <!--<TextBlock Text="{Binding NumRQs, StringFormat={}/s}" Margin="50,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>-->
                            <TextBlock Text="0.00/s" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="7">
                            <!--<TextBlock Text="{Binding NumResponses, StringFormat=Responses: {}}" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>-->
                            <TextBlock Text="Responses: 0" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="7">
                            <!--<TextBlock Text="{Binding NumRPs, StringFormat={}/s}" Margin="50,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>-->
                            <TextBlock Text="0.00/s" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>